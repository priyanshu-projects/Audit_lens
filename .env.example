# ============================================================
# AuditLens — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to Git
# ============================================================

# --- Gemini (Google AI Studio) ---
# Get yours free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- HuggingFace Hub ---
# Get token at: https://huggingface.co/settings/tokens
# Needed to upload/download fine-tuned finbert-esg model
HF_TOKEN=your_hf_token_here
HF_USERNAME=your_hf_username_here        # e.g. johndoe → model will be johndoe/finbert-esg

# --- GCP (Google Cloud Platform) ---
# Create project at: https://console.cloud.google.com
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=us-central1
GCP_BUCKET=auditlens-storage             # Cloud Storage bucket name
GCP_ARTIFACT_REGISTRY=auditlens-registry

# --- GitHub (for retraining trigger) ---
# Create token at: https://github.com/settings/tokens (needs repo + workflow scope)
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your_github_username/esg-audit-assistant

# --- CDP API (optional — Level 4 consistency check) ---
# Request access at: https://www.cdp.net/en/developer
CDP_API_KEY=your_cdp_api_key_here

# --- App Settings ---
# Set to "production" when deployed to Cloud Run
APP_ENV=development
LOG_LEVEL=INFO

# --- Model Settings ---
# Points to HF Hub model once uploaded; falls back to pretrained during dev
FINBERT_MODEL_ID=ProsusAI/finbert        # replace with your-username/finbert-esg after Week 2
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# --- EDGAR ---
# No API key needed — EDGAR is public
# But provide a valid email for their User-Agent header requirement
EDGAR_USER_AGENT=YourName YourEmail@gmail.com
