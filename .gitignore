# ============================================================
# AuditLens — .gitignore
# ============================================================

# --- Environment & Secrets ---
.env
*.env.local

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
venv/
env/
.venv/
ENV/

# --- Data (large files — use DVC instead) ---
data/raw/
data/processed/
data/training/
data/knowledge_base/*.pdf
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/training/.gitkeep
!data/knowledge_base/.gitkeep
# Allow FAISS index files to be committed (needed for Docker build in CI/CD)
!data/knowledge_base/*.faiss
!data/knowledge_base/*.index
!data/knowledge_base/chunks.json

# --- Models (stored in HuggingFace Hub / GCS) ---
models/
*.bin
*.safetensors
*.pt
*.pth

# --- FAISS Index (rebuilt from GCS) ---
# *.faiss and *.index are allowed in data/knowledge_base (see above)
# but excluded everywhere else (e.g. local test indexes)
*.faiss
*.index
!data/knowledge_base/*.faiss
!data/knowledge_base/*.index

# --- MLflow ---
mlruns/
mlflow.db

# --- DVC ---
.dvc/cache
.dvc/tmp
/tmp

# --- Evidently Reports ---
reports/

# --- Logs ---
logs/
*.log

# --- Streamlit ---
.streamlit/secrets.toml

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db

# --- Docker ---
.dockerignore

# --- Pytest ---
.pytest_cache/
.coverage
htmlcov/
